# Gemini
# Gemini API: tự xoay vòng GEMINI_API_KEY, GEMINI_API_KEY1..4 và GEMINI_FALLBACK_API_KEYS.
# Key lỗi/hết quota (429) bị tạm bỏ qua GEMINI_KEY_COOLDOWN_SECONDS giây rồi mới thử lại.
GEMINI_KEY_COOLDOWN_SECONDS=3600
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
IDEA_STYLE="Hài hước, bất ngờ, nhịp nhanh, có câu móc mở đầu trong 1 giây, tình huống leo thang và cú bẻ lái dễ nhớ. Luân phiên nhiều nội dung hài hước đời thường Việt Nam nhưng luôn giữ cố định 2 nhân vật gốc là Khỉ (@khi, giọng @Voice_Khi) và Người (@nguoi, giọng @Voice_Nguoi); tránh lặp mô-típ, thoại tự nhiên kiểu Việt Nam, gag hình ảnh rõ, phù hợp mọi lứa tuổi."
CHARACTER_1_TAG=@khi
CHARACTER_1_VOICE=@Voice_Khi
CHARACTER_2_TAG=@nguoi
CHARACTER_2_VOICE=@Voice_Nguoi

# Telegram bot and private chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Google Flow UI (selectors are CSS selectors and must match the current UI)
FLOW_PROJECT_URL=
FLOW_AUTH_FILE=auth.json
# Danh sách các profile tài khoản Flow (cách nhau dấu phẩy, ví dụ: a,b,c,d). Để trống sẽ tự động quét tất cả profile đã lưu trong storage/flow_profiles/
FLOW_PROFILES=
FLOW_AGENT_TOGGLE_SELECTOR=button[aria-pressed]:has-text("Agent")
FLOW_SETTINGS_SELECTOR=button[aria-label="Settings trigger"]:visible
FLOW_VIDEO_MODE_SELECTOR=button[role="radio"]:has-text("Video")
FLOW_ASPECT_RATIO_SELECTOR=button[role="radio"]:has-text("9:16")
FLOW_DURATION_SELECTOR=button[role="radio"]:has-text("10s")
FLOW_OUTPUT_COUNT_SELECTOR=button[role="radio"]:has-text("x1")
FLOW_PROMPT_SELECTOR=[contenteditable="true"][aria-label="What do you want to create?"]
FLOW_SUBMIT_SELECTOR=button[aria-label="Start generation"]
FLOW_RESULT_SELECTOR=flow-grid-tile-container[role="group"]:has(flow-video-tile)
FLOW_DOWNLOAD_MENU_SELECTOR=button[aria-label="More options"]
FLOW_DOWNLOAD_SELECTOR=[role="menuitem"]:has-text("720p Original size")
FLOW_RENDER_TIMEOUT_MS=900000
# Chế độ tạo (chỉnh được trên dashboard: Cấu hình > Flow & Gemini, ghi đè các giá trị dưới đây)
#   scene = tắt Agent, dán từng cảnh; agent = Flow Agent tự tạo
FLOW_GENERATION_MODE=scene
FLOW_INPUT_MODE=ingredients
FLOW_ASPECT_RATIO=9:16
FLOW_VIDEO_MODEL=Omni 1.1 Flash
FLOW_RESOLUTION=720p
# 4 | 6 | 8 | 10 | auto (thời lượng chỉ có ở Omni 1.1 Flash)
FLOW_DURATION=10
FLOW_OUTPUT_COUNT=1
FLOW_ATTACH_VOICE=true
FLOW_DOWNLOAD_TIMEOUT_MS=900000
# Nút "🔍 Kiểm tra" tài khoản Flow trên Telegram mở Chrome ẩn; đặt false để thấy cửa sổ khi kiểm tra
FLOW_CHECK_HEADLESS=true

# YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=yt_token.json

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Facebook Graph API / Reels
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

LOG_LEVEL=INFO

# Chất lượng tải video từ Flow: 720 | 1080 | 4k (1080/4k: Flow tăng độ phân giải ~1 phút)
FLOW_DOWNLOAD_QUALITY=1080

# Bóc thoại link TikTok (nút 🎵 Bóc thoại TikTok trên Telegram, hoặc python -m core.link_transcriber)
# Model Whisper: tiny | base | small | medium (càng lớn càng chính xác nhưng chậm hơn trên CPU)
WHISPER_MODEL=small
# Mã ngôn ngữ âm thanh, hoặc auto
TRANSCRIBE_LANGUAGE=vi
# Tuỳ chọn: file cookies.txt (định dạng Netscape) của tài khoản YouTube của bạn,
# chỉ cần khi link YouTube báo "Sign in to confirm you're not a bot". KHÔNG commit file này.
YTDLP_COOKIES_FILE=
